{
  "name": "keyflow-sync-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:init": "wrangler d1 execute keyflow-sync --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute keyflow-sync --remote --file=./schema.sql"
  },
  "dependencies": {
    "hono": "^4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.9",
    "@cloudflare/workers-types": "^4",
    "typescript": "^5",
    "vitest": "^4.1.0",
    "wrangler": "^4"
  }
}
